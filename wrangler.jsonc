{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mergulho-raro",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mergulho-raro"
    }
  ]
}
